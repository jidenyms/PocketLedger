# Copy to .env and fill in values. Never commit .env.

# SQLite (local dev) — path is relative to this prisma/ folder when schema lives in prisma/
# DATABASE_URL="file:./dev.db"

# PostgreSQL (production example)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pocketledger?schema=public"

DATABASE_URL="file:./dev.db"

# Signing secret for JWT in httpOnly cookie (min 32 chars in production)
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Session length in seconds (JWT exp + cookie maxAge; default 7 days)
# SESSION_MAX_AGE_SECONDS=604800

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# After first setup: npx prisma db push && npm run db:seed
# Demo login: demo@pocketledger.com / Demo123!
